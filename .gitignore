# version: 261005
# Local/generated market data - never committed.
# Real market data has redistribution restrictions and the Claude GitHub
# integration can't usefully read binary files anyway. Re-upload the .db directly to
# whichever chat needs it instead.
fx_trader/data/*.db
fx_trader/data/*.db-journal

# Raw Kraken bulk-CSV exports (ingest_kraken_gbp_csv.py's input, NOT
# fx_trader/data/ - a sibling directory) - same redistribution-
# restriction reasoning as data/*.db above. Pre-existing gap, not
# something this session introduced - never excluded until now.
fx_trader/kraken_csv/

# Local/generated chart outputs (visualize_period_comparison.py) - same
# reasoning as data/*.db above, minus the redistribution concern: these
# are regenerable from code + data, would bloat git history with binary
# PNG/HTML diffs on every re-run, and aren't meant to be hand-maintained.
# Keep locally / re-upload to a chat if a specific snapshot matters.
fx_trader/charts/*.png
fx_trader/charts/*.html

# Local run-monitor logs (run_monitor.py): generated per run, local only,
# never the cloud DB. Paste `python run_monitor.py summary <file>` output
# (or attach the file) to a chat when its timings matter.
fx_trader/logs/*.jsonl

# Audit reports and sandbox manifests (audit_sandbox_alignment.py): generated per run,
# local only. Keep a manifest locally and back it up with the sandbox DB.
fx_trader/reports/*.json
fx_trader/reports/*.txt

# Local chat-start files (utilities/chat_preflight.py): machine_profile.md holds account tiers and local paths; chat_start.txt is regenerated each run
fx_trader/local/

# Credentials - never commit these, however you choose to set them locally
.env
*.env
fx_trader/.env

# Python
__pycache__/
*.pyc
.venv/
venv/
*.egg-info/

# macOS
.DS_Store
